{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "izumi-chonaikai-public-site",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-03-10",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		// 独自ドメイン(hassamu-izumi.com)取得後に差し替える
		"NEXT_PUBLIC_SITE_URL": "https://izumi-chonaikai-public-site.cs-support.workers.dev"
	},
	// workers リポジトリと同じ D1（記事・行事の読み取り専用利用）
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "izumi-chonaikai",
			"database_id": "95d981e3-252c-4cee-8d9f-59f53ad30f03"
		}
	]
}
